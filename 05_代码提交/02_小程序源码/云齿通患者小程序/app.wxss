page {
  background: #f5f7fa;
  color: #1f2937;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
}
.page { min-height: 100vh; padding: 24rpx 24rpx 60rpx; box-sizing: border-box; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(15, 118, 110, 0.06); }
.card-title { font-size: 30rpx; font-weight: 700; color: #0f766e; margin-bottom: 20rpx; display: block; }
.muted { color: #6b7280; font-size: 24rpx; }
.small { font-size: 24rpx; }
.green { color: #0f766e; }
.orange { color: #d97706; }
.red { color: #dc2626; }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.divider { height: 1rpx; background: #eef2f5; margin: 20rpx 0; }
.tag { display: inline-block; padding: 6rpx 16rpx; border-radius: 999rpx;
  background: #ccfbf1; color: #0f766e; font-size: 22rpx; }
.tag-warn { background: #fef3c7; color: #b45309; }
.tag-gray { background: #f1f5f9; color: #64748b; }
.btn { display: block; width: 100%; box-sizing: border-box; border-radius: 14rpx;
  padding: 22rpx 0; text-align: center; font-size: 28rpx; border: none; line-height: 1.4; }
.btn-primary { background: #0f766e; color: #fff; }
.btn-ghost { background: #f0fdfa; color: #0f766e; border: 2rpx solid #99f6e4; }
.btn-sm { display: inline-block; width: auto; padding: 10rpx 26rpx; font-size: 24rpx; }
.grid { display: flex; flex-wrap: wrap; }
.grid-4 > view { width: 25%; box-sizing: border-box; }
.entry { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24rpx 8rpx; }
.entry-icon { width: 84rpx; height: 84rpx; border-radius: 24rpx; background: #f0fdfa;
  display: flex; align-items: center; justify-content: center; font-size: 32rpx;
  color: #0f766e; font-weight: 700; margin-bottom: 12rpx; }
.entry-text { font-size: 24rpx; color: #374151; }
.stat-num { font-size: 44rpx; font-weight: 700; color: #0f766e; display: block; }
.stat-label { font-size: 22rpx; color: #6b7280; }
.list-item { display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 0; border-bottom: 1rpx solid #eef2f5; }
.list-item:last-child { border-bottom: none; }
.item-title { font-size: 28rpx; font-weight: 600; display: block; }
.item-sub { font-size: 23rpx; color: #6b7280; display: block; margin-top: 8rpx; }
.input { background: #f8fafc; border: 2rpx solid #e2e8f0; border-radius: 12rpx;
  padding: 0 24rpx; height: 92rpx; line-height: 92rpx; font-size: 30rpx;
  width: 100%; box-sizing: border-box; }
.textarea { background: #f8fafc; border: 2rpx solid #e2e8f0; border-radius: 12rpx;
  padding: 20rpx 22rpx; font-size: 27rpx; width: 100%; height: 160rpx; box-sizing: border-box; }
.field-label { font-size: 25rpx; color: #374151; display: block; margin: 22rpx 0 12rpx; }
.picker { background: #f8fafc; border: 2rpx solid #e2e8f0; border-radius: 12rpx;
  padding: 20rpx 22rpx; font-size: 27rpx; color: #334155; }
.hero { background: linear-gradient(135deg, #0f766e, #14b8a6); border-radius: 24rpx;
  padding: 44rpx 36rpx; color: #fff; margin-bottom: 24rpx; }
.hero-title { font-size: 44rpx; font-weight: 700; display: block; }
.hero-sub { font-size: 24rpx; opacity: 0.9; display: block; margin-top: 12rpx; }
.empty { text-align: center; color: #94a3b8; font-size: 25rpx; padding: 50rpx 0; }
.kv { display: flex; justify-content: space-between; font-size: 26rpx; padding: 12rpx 0; }
.kv-label { color: #6b7280; }
.login-page { min-height: 100vh; background: linear-gradient(160deg, #0b3a3e, #0f766e 60%, #14b8a6);
  display: flex; flex-direction: column; justify-content: center; padding: 0 64rpx; box-sizing: border-box; }
.login-brand { text-align: center; margin-bottom: 72rpx; }
.login-logo { width: 112rpx; height: 112rpx; border-radius: 32rpx; background: rgba(255,255,255,.18);
  color: #fff; font-size: 52rpx; font-weight: 700; line-height: 112rpx; text-align: center; margin: 0 auto 28rpx; }
.login-title { display: block; color: #fff; font-size: 42rpx; font-weight: 700; letter-spacing: 2rpx; }
.login-sub { display: block; color: rgba(255,255,255,.78); font-size: 24rpx; margin-top: 12rpx; }
.login-box { background: #fff; border-radius: 24rpx; padding: 56rpx 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,.12); }
.login-box .input { margin-bottom: 30rpx; }
.login-btn { margin-top: 16rpx; height: 92rpx; line-height: 92rpx; padding: 0; font-size: 32rpx; }
.ph { color: #94a3b8; font-size: 29rpx; }
