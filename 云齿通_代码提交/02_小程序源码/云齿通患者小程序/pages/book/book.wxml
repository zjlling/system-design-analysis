<view class="page">
  <view class="card">
    <text class="card-title">预约挂号</text>

    <text class="field-label">就诊门店</text>
    <picker class="picker" range="{{shopNames}}" value="{{shopIndex}}" bindchange="onShop">
      <view>{{shopNames[shopIndex]}}</view>
    </picker>

    <text class="field-label">就诊科室</text>
    <picker class="picker" range="{{deptNames}}" value="{{deptIndex}}" bindchange="onDept">
      <view>{{deptNames[deptIndex]}}</view>
    </picker>

    <text class="field-label">医生</text>
    <picker class="picker" range="{{doctorNames}}" value="{{doctorIndex}}" bindchange="onDoctor">
      <view>{{doctorNames[doctorIndex]}}</view>
    </picker>

    <text class="field-label">诊疗项目</text>
    <picker class="picker" range="{{serviceNames}}" value="{{serviceIndex}}" bindchange="onService">
      <view>{{serviceNames[serviceIndex]}}</view>
    </picker>

    <text class="field-label">就诊日期</text>
    <picker class="picker" range="{{dates}}" value="{{dateIndex}}" bindchange="onDate">
      <view>{{dates[dateIndex]}}</view>
    </picker>

    <text class="field-label">就诊时段</text>
    <picker class="picker" range="{{times}}" value="{{timeIndex}}" bindchange="onTime">
      <view>{{times[timeIndex]}}</view>
    </picker>

    <button class="btn btn-primary" style="margin-top:36rpx" bindtap="submit">提交预约</button>
  </view>

  <view class="card">
    <text class="card-title">我的预约</text>
    <view class="list-item" wx:for="{{list}}" wx:key="id">
      <view style="flex:1">
        <text class="item-title">{{item.date}} {{item.time}}</text>
        <text class="item-sub">{{item.shopName}} · {{item.doctor}} · {{item.item}}</text>
      </view>
      <view style="text-align:right">
        <text class="tag">{{item.status}}</text>
        <button class="btn btn-sm btn-ghost" style="margin-top:12rpx" wx:if="{{item.canCancel}}"
          data-id="{{item.id}}" bindtap="cancel">取消</button>
      </view>
    </view>
    <view class="empty" wx:if="{{list.length === 0}}">暂无预约记录</view>
  </view>
</view>
