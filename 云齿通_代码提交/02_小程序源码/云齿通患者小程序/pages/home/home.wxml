<view class="page">
  <view class="hero">
    <text class="hero-title">你好，{{name}}</text>
    <text class="hero-sub">{{shopName}} · {{level}}</text>
  </view>

  <view class="card">
    <view class="grid-4">
      <view class="entry" wx:for="{{entries}}" wx:key="text" data-url="{{item.url}}" bindtap="go">
        <text class="entry-icon">{{item.icon}}</text>
        <text class="entry-text">{{item.text}}</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{next.id}}">
    <text class="card-title">下次预约</text>
    <view class="list-item">
      <text class="item-title">{{next.date}} {{next.time}}</text>
      <text class="tag">{{next.status}}</text>
    </view>
    <text class="item-sub">{{next.shopName}} · {{next.doctor}} · {{next.item}} · {{next.chair}}</text>
  </view>

  <view class="card">
    <text class="card-title">待支付账单</text>
    <view class="list-item" wx:for="{{pending}}" wx:key="id">
      <text class="item-title">{{item.item}}</text>
      <text class="tag tag-warn">¥{{item.amount}}</text>
    </view>
    <view class="empty" wx:if="{{pending.length === 0}}">暂无待支付账单</view>
  </view>

  <view class="card">
    <text class="card-title">门诊公告</text>
    <view class="list-item" wx:for="{{notices}}" wx:key="id">
      <text class="item-title">{{item.text}}</text>
      <text class="tag">{{item.tag}}</text>
    </view>
  </view>

  <button class="btn btn-ghost" bindtap="logout">退出登录</button>
</view>
