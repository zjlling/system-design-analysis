<view class="page">
  <view class="card">
    <text class="card-title">待支付</text>
    <view class="list-item" wx:for="{{pending}}" wx:key="id">
      <view style="flex:1">
        <text class="item-title">{{item.item}}</text>
        <text class="item-sub">{{item.billNo}} · {{item.shopName}} · {{item.date}}</text>
        <view style="margin-top:14rpx">
          <button class="btn btn-sm btn-primary" data-id="{{item.id}}" data-method="微信" bindtap="pay">微信支付</button>
          <button class="btn btn-sm btn-ghost" data-id="{{item.id}}" data-method="支付宝" bindtap="pay">支付宝</button>
        </view>
      </view>
      <text class="tag tag-warn">¥{{item.amount}}</text>
    </view>
    <view class="empty" wx:if="{{pending.length === 0}}">暂无待支付账单</view>
  </view>

  <view class="card">
    <text class="card-title">缴费记录与电子收据</text>
    <view class="list-item" wx:for="{{paid}}" wx:key="id">
      <view style="flex:1">
        <text class="item-title">{{item.item}}</text>
        <text class="item-sub">{{item.method}} · {{item.shopName}} · {{item.date}}</text>
        <text class="item-sub">收据号 {{item.receipt}}</text>
      </view>
      <text class="tag">¥{{item.amount}}</text>
    </view>
    <view class="empty" wx:if="{{paid.length === 0}}">暂无缴费记录</view>
  </view>
</view>
